#!/bin/sh
# MarsOS - ajustes finais dentro do chroot
set -e

echo "marte" > /etc/hostname

# Locales: ingles e portugues (escolhidos no menu de boot)
sed -i -e 's/^# *\(pt_BR.UTF-8 UTF-8\)/\1/' -e 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen

# Console de texto com fonte Terminus
if [ -f /etc/default/console-setup ]; then
	sed -i -e 's/^FONTFACE=.*/FONTFACE="Terminus"/' -e 's/^FONTSIZE=.*/FONTSIZE="8x16"/' /etc/default/console-setup
fi

# Libera fontes bitmap (Terminus) para os apps Tk/Xft
rm -f /etc/fonts/conf.d/70-no-bitmaps*.conf
if [ -e /usr/share/fontconfig/conf.avail/70-yes-bitmaps.conf ]; then
	ln -sf /usr/share/fontconfig/conf.avail/70-yes-bitmaps.conf /etc/fonts/conf.d/70-yes-bitmaps.conf
fi
fc-cache -f >/dev/null 2>&1 || true

# Scripts do MarsOS executaveis
chmod 755 /usr/local/bin/* /usr/lib/marsos/*.py 2>/dev/null || true

# Xorg sem root quando possivel (com o wrapper legacy como reserva)
if [ -f /etc/X11/Xwrapper.config ]; then
	sed -i 's/^allowed_users=.*/allowed_users=anybody/' /etc/X11/Xwrapper.config
	grep -q '^needs_root_rights' /etc/X11/Xwrapper.config || echo 'needs_root_rights=auto' >> /etc/X11/Xwrapper.config
fi

# O MOTD dinamico do Debian (aviso de garantia) da lugar ao do MarsOS
rm -f /etc/update-motd.d/10-uname 2>/dev/null || true

# Dillo com cara de Marte
if [ -f /etc/dillo/dillorc ]; then
	cat >> /etc/dillo/dillorc <<'EOF'

# --- MarsOS ---
bg_color=0x1a1117
allow_white_bg=NO
link_color=0xff8933
visited_color=0xc77a9a
ui_main_bg_color=0x3d2836
ui_text_bg_color=0x1a1117
ui_fg_color=0xe8c9a8
ui_selection_color=0xe54438
ui_tab_active_bg_color1=0xe54438
ui_tab_bg_color1=0x51323e
ui_tab_active_fg_color=0xfff1dc
ui_tab_fg_color=0xe8c9a8
start_page="file:/usr/share/marsos/inicio.html"
home="file:/usr/share/marsos/inicio.html"
save_dir=/home/astronauta/Downloads/
EOF
fi

# Som: garante que o PipeWire sobe sozinho na sessao de cada usuario
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service >/dev/null 2>&1 || true

# Pastas padrao: ~/Downloads ja vem no skel; Documentos/Imagens (ou Documents/Pictures)
# sao criadas pelo ~/.xinitrc no idioma da sessao
mkdir -p /etc/skel/Downloads

# Firefox: abre na pagina inicial do MarsOS e salva em ~/Downloads sem perguntar.
# distribution.ini e o jeito que o Firefox oferece para distribuicoes mudarem o padrao
# (um .js em defaults/pref e sobrescrito pelas preferencias do proprio navegador).
# O idioma segue o sistema: o Debian ja define intl.locale.requested = "".
if [ -d /usr/lib/firefox-esr ]; then
	mkdir -p /usr/lib/firefox-esr/distribution
	cat > /usr/lib/firefox-esr/distribution/distribution.ini <<'EOF'
[Global]
id=marsos
version=1.1
about=MarsOS

[Preferences]
browser.startup.homepage="file:///usr/share/marsos/inicio.html"
browser.startup.page=1
browser.startup.firstrunSkipsHomepage=false
browser.download.useDownloadDir=true
browser.download.folderList=1
browser.shell.checkDefaultBrowser=false
browser.aboutwelcome.enabled=false
trailhead.firstrun.didSeeAboutWelcome=true
browser.startup.homepage_override.mstone="ignore"
startup.homepage_welcome_url=""
startup.homepage_welcome_url.additional=""
datareporting.policy.dataSubmissionPolicyBypassNotification=true
EOF
fi
