#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""marsos-globo - o planeta do logo do MarsOS girando, num ceu estrelado."""
import sys
import tkinter as tk

sys.path.insert(0, "/usr/lib/marsos")
import marstime  # noqa: E402
from marstk import AMBAR, AREIA, FONTE, FUNDO, PlanetaGirando, estrelas, janela  # noqa: E402

ZOOM = 3
L, A = 100 * ZOOM + 80, 100 * ZOOM + 110

root = janela("MarsGlobo", "Globo de Marte")
root.resizable(False, False)
c = tk.Canvas(root, width=L, height=A, bg=FUNDO, highlightthickness=0)
c.pack()
estrelas(c, L, A, 160, semente=9)
PlanetaGirando(c, L // 2, 40 + 50 * ZOOM, zoom=ZOOM)
c.create_text(L // 2, 20, text="M A R T E", fill=AMBAR, font=(FONTE, -24, "bold"))
info = c.create_text(L // 2, A - 34, text="", fill=AREIA, font=(FONTE, -16), justify="center")


def tick():
    h = marstime.calcular()
    c.itemconfig(info, text=f"Sol {marstime.milhar(h.sol)}  ·  {h.mtc_hms} MTC\n"
                            f"Ano marciano {h.ano}  ·  {h.estacao_norte} (norte)")
    root.after(1000, tick)


tick()
root.bind("<Escape>", lambda e: root.destroy())
root.mainloop()
