#!/bin/sh
# marsos-gparted - abre o GParted como administrador.
# Na sessao live o sudo nao pede senha; no sistema instalado a senha e pedida num terminal.
cmd="env DISPLAY=$DISPLAY XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority} gparted"
if sudo -n true 2>/dev/null; then
	exec sudo -n $cmd
fi
exec xterm -title "GParted" -geometry 70x8 -e sh -c "sudo $cmd"
