#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""sol - mostra a hora e a data em Marte.   Uso: sol [--curto]"""
import sys
import time

sys.path.insert(0, "/usr/lib/marsos")
import marstime  # noqa: E402
from marsi18n import _, num  # noqa: E402

h = marstime.calcular()

if "--curto" in sys.argv:
    print(_("Sol {sol} · {mtc} MTC · Ano {ano} · {est} no norte").format(
        sol=marstime.milhar(h.sol), mtc=h.mtc_hms[:5], ano=h.ano, est=h.estacao_norte))
    sys.exit(0)

cor = sys.stdout.isatty()
V = "\033[1;31m" if cor else ""
L = "\033[1;33m" if cor else ""
A = "\033[0;33m" if cor else ""
N = "\033[0m" if cor else ""


def linha(rotulo, valor):
    print(f"  {A}{rotulo:.<26}{N} {valor}")


print()
print(f"  {V}{_('MarsOS · Relógio Marciano')}{N}")
print(f"  {A}{'─' * 44}{N}")
linha(_("Sol marciano (MSD) "), f"{L}{marstime.milhar(h.sol)}{N}  ({num(h.msd, 4)})")
linha(_("Hora coordenada (MTC) "), f"{L}{h.mtc_hms}{N}")
linha(_("Ano marciano "), f"{h.ano}")
linha(_("Longitude solar (Ls) "), f"{num(h.ls, 1)}°")
linha(_("Estação "), _("{n} no norte · {s} no sul").format(n=h.estacao_norte, s=h.estacao_sul))
for nome, lon in marstime.LOCAIS:
    linha(nome + " ", _("{h} (hora local)").format(h=h.hms(h.lmst(lon))[:5]))
linha(_("Terra (UTC) "), time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(h.unix)))
print()
