#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""sol - mostra a hora e a data em Marte.   Uso: sol [--curto]"""
import sys
import time

sys.path.insert(0, "/usr/lib/marsos")
import marstime  # noqa: E402

h = marstime.calcular()

if "--curto" in sys.argv:
    print(f"Sol {marstime.milhar(h.sol)} · {h.mtc_hms[:5]} MTC · Ano {h.ano} · {h.estacao_norte} no norte")
    sys.exit(0)

cor = sys.stdout.isatty()
V = "\033[1;31m" if cor else ""
L = "\033[1;33m" if cor else ""
A = "\033[0;33m" if cor else ""
N = "\033[0m" if cor else ""


def linha(rotulo, valor):
    print(f"  {A}{rotulo:.<26}{N} {valor}")


print()
print(f"  {V}MarsOS · Relógio Marciano{N}")
print(f"  {A}{'─' * 44}{N}")
linha("Sol marciano (MSD) ", f"{L}{marstime.milhar(h.sol)}{N}  ({h.msd:.4f})")
linha("Hora coordenada (MTC) ", f"{L}{h.mtc_hms}{N}")
linha("Ano marciano ", f"{h.ano}")
linha("Longitude solar (Ls) ", f"{h.ls:.1f}°".replace(".", ","))
linha("Estação ", f"{h.estacao_norte} no norte · {h.estacao_sul} no sul")
for nome, lon in marstime.LOCAIS:
    linha(nome + " ", f"{h.hms(h.lmst(lon))[:5]} (hora local)")
linha("Terra (UTC) ", time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(h.unix)))
print()
