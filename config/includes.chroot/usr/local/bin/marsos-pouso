# ------------------------------------------------------------------ jogo (Tk)
def jogo(demo=False):
    import subprocess
    import tkinter as tk

    import marstime
    from marstk import AMBAR, AREIA, CREME, FONTE, FUNDO, LARANJA, NOITE, ROCHA, VERMELHO, janela

    VERDE = "#b8c46a"
    SONS = "/usr/share/marsos/sons"
    titulo_jogo = _("Pouso Marciano")

    root = janela("MarsPouso", titulo_jogo)
    root.resizable(False, False)
    cv = tk.Canvas(root, width=LARGURA, height=ALTURA, bg=FUNDO, highlightthickness=0)
    cv.pack()

    estado = {"tela": "titulo", "nivel": 0, "pontos": 0, "vidas": 3, "som": True, "mundo": None,
              "recorde": ler_recorde(), "ultimo": time.monotonic(), "motor_som": 0.0, "alerta": 100,
              "pausa": False, "particulas": [], "poeira": [], "demo": demo}
    teclas = set()
    soltar = {}

    # ---------------------------------------------------------- sons
    def tocar(nome):
        if not estado["som"]:
            return
        arq = f"{SONS}/{nome}.wav"
        for prog in ("pw-play", "paplay", "aplay"):
            try:
                subprocess.Popen([prog, arq], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return
            except OSError:
                continue

    # ---------------------------------------------------------- sprites girados
    def girar_sprite(angulo):
        a = math.radians(-angulo)
        tam = 19
        img = tk.PhotoImage(width=tam, height=tam)
        for y in range(tam):
            for x in range(tam):
                dx, dy = x - tam / 2 + 0.5, y - tam / 2 + 0.5
                sx = dx * math.cos(a) - dy * math.sin(a) + 6.5
                sy = dx * math.sin(a) + dy * math.cos(a) + 6.0
                ix, iy = math.floor(sx), math.floor(sy)
                if 0 <= iy < len(SONDA) and 0 <= ix < len(SONDA[0]):
                    ch = SONDA[iy][ix]
                    if ch != ".":
                        img.put(CORES[ch], (x, y))
        return img.zoom(ZOOM)

    angulos = list(range(-90, 91, 6))
    sprites = {ang: girar_sprite(ang) for ang in angulos}

    def sprite_para(angulo):
        return sprites[min(angulos, key=lambda a: abs(a - angulo))]

    # ---------------------------------------------------------- texto pixelado
    def texto_pixel(x, y, txt, tam, cor, sombra="#0e0a12", tag="ui", centro=True):
        txt = txt.upper()
        largura = len(txt) * 6 * tam - tam
        x0 = x - largura / 2 if centro else x
        for desloc, c in (((tam // 2 + 1), sombra), (0, cor)):
            for k, ch in enumerate(txt):
                linhas = FONTE5X7.get(ch, FONTE5X7["?"]).split("|")
                for j, linha in enumerate(linhas):
                    for i, px in enumerate(linha):
                        if px == "#":
                            rx = x0 + (k * 6 + i) * tam + desloc
                            ry = y + j * tam + desloc
                            cv.create_rectangle(rx, ry, rx + tam, ry + tam, fill=c, outline="", tags=tag)

    # ---------------------------------------------------------- cenario
    def misturar(c1, c2, t):
        a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]
        b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
        return "#%02x%02x%02x" % tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))

    def desenhar_ceu(local, rnd):
        topo, horiz = local["ceu"]
        niveis = 10
        bayer = (0, 2, 1, 3)
        for y in range(0, ALTURA, 2):
            t = min(1.0, y / (ALTURA * 0.85))
            v = t * (niveis - 1)
            k = int(v) + (1 if (v - int(v)) * 4 > bayer[(y // 2) % 4] + 0.5 else 0)
            cv.create_rectangle(0, y, LARGURA, y + 2, fill=misturar(topo, horiz, min(1, k / (niveis - 1))),
                                outline="", tags="cenario")
        for _i in range(local["estrelas"]):
            x, y = rnd.randrange(LARGURA), rnd.randrange(int(ALTURA * 0.6))
            cor = rnd.choice((CREME, AREIA, AMBAR, "#8fb0d9", ROCHA))
            cv.create_rectangle(x, y, x + 2, y + 2, fill=cor, outline="", tags="cenario")
        if local.get("terra"):               # a Terra: um pontinho azul no ceu (entre os paineis)
            x, y = rnd.randrange(280, LARGURA - 300), rnd.randrange(40, 100)
            cv.create_rectangle(x, y, x + 4, y + 4, fill="#8fb0d9", outline="", tags="cenario")
            cv.create_rectangle(x + 1, y + 1, x + 2, y + 2, fill="#cfe0f0", outline="", tags="cenario")
            cv.create_text(x + 8, y - 2, text=_("Terra"), anchor="w", fill="#8fb0d9",
                           font=(FONTE, -12), tags="cenario")
        # Fobos (a lua maior) cruza o ceu devagar
        estado["fobos_x"] = rnd.uniform(0, LARGURA)
        fx = estado["fobos_x"] - 30
        estado["fobos"] = cv.create_oval(fx, 40, fx + 14, 50, fill="#9a8a86", outline="#5a4a4a", tags="cenario")

    def desenhar_terreno(m):
        local = m.local
        pts = [0, ALTURA]
        for i, y in enumerate(m.terreno):
            pts += [i * CELULA, y, (i + 1) * CELULA, y]
        pts += [LARGURA, ALTURA]
        cv.create_polygon(pts, fill=local["rocha"], outline="", tags="cenario")
        # estratos (linhas mais escuras acompanhando o relevo)
        for k, cor in ((18, local["sombra"]), (44, local["sombra"]), (80, "#2a1c24")):
            linha = []
            for i, y in enumerate(m.terreno):
                linha += [i * CELULA, y + k, (i + 1) * CELULA, y + k]
            cv.create_line(linha, fill=cor, width=2, tags="cenario")
        # borda iluminada
        borda = []
        for i, y in enumerate(m.terreno):
            borda += [i * CELULA, y + 1, (i + 1) * CELULA, y + 1]
        cv.create_line(borda, fill=local["borda"], width=2, tags="cenario")
        # plataformas
        estado["luzes"] = []
        for p in m.plataformas:
            cv.create_rectangle(p["x0"], p["y"], p["x1"], p["y"] + 6, fill="#c9a892", outline="#3d2836",
                                tags="cenario")
            for x in range(p["x0"] + 4, p["x1"] - 2, 8):
                cv.create_rectangle(x, p["y"] + 2, x + 4, p["y"] + 4, fill="#ffb45e", outline="", tags="cenario")
            for x in (p["x0"] - 2, p["x1"] - 2):
                estado["luzes"].append(cv.create_rectangle(x, p["y"] - 6, x + 4, p["y"] - 2, fill=VERMELHO,
                                                           outline="", tags="cenario"))
            cv.create_text((p["x0"] + p["x1"]) / 2, p["y"] - 14, text=f"x{p['mult']}", fill=CREME,
                           font=(FONTE, -14, "bold"), tags="cenario")

    # ---------------------------------------------------------- HUD
    def criar_hud():
        cv.create_rectangle(8, 8, 238, 112, fill=FUNDO, outline=ROCHA, width=2, tags="hud")
        estado["hud"] = {}
        rotulos = [("alt", _("ALTITUDE")), ("vy", _("VEL. VERT.")), ("vx", _("VEL. HORIZ.")),
                   ("ang", _("ÂNGULO")), ("comb", _("COMBUSTÍVEL"))]
        for i, (k, r) in enumerate(rotulos):
            cv.create_text(16, 18 + i * 19, text=r, anchor="w", fill=AREIA, font=(FONTE, -14), tags="hud")
            estado["hud"][k] = cv.create_text(230, 18 + i * 19, text="", anchor="e", fill=CREME,
                                              font=(FONTE, -14, "bold"), tags="hud")
        estado["barra"] = cv.create_rectangle(0, 0, 0, 0, fill=VERDE, outline="", tags="hud")
        cv.create_rectangle(LARGURA - 238, 8, LARGURA - 8, 112, fill=FUNDO, outline=ROCHA, width=2, tags="hud")
        for k, y in (("pontos", 18), ("local", 37), ("vento", 56), ("vidas", 75), ("recorde", 94)):
            estado["hud"][k] = cv.create_text(LARGURA - 230, y, text="", anchor="w", fill=AREIA,
                                              font=(FONTE, -14, "bold" if k == "pontos" else ""), tags="hud")

    def atualizar_hud(m):
        h = estado["hud"]

        def cor(ok):
            return VERDE if ok else VERMELHO

        cv.itemconfig(h["alt"], text=f"{m.altitude():.0f} m")
        cv.itemconfig(h["vy"], text=f"{num(abs(m.vy), 1)} m/s {'↓' if m.vy > 0 else '↑'}", fill=cor(m.vy <= LIMITE_VY))
        cv.itemconfig(h["vx"], text=f"{num(abs(m.vx), 1)} m/s {'→' if m.vx > 0 else '←'}",
                      fill=cor(abs(m.vx) <= LIMITE_VX))
        cv.itemconfig(h["ang"], text=f"{m.angulo:+.0f}°", fill=cor(abs(m.angulo) <= LIMITE_ANG))
        cv.itemconfig(h["comb"], text=f"{m.combustivel:.0f}%", fill=cor(m.combustivel > 20))
        largura = 214 * m.combustivel / 100
        cv.coords(estado["barra"], 16, 104, 16 + largura, 108)
        cv.itemconfig(estado["barra"], fill=VERDE if m.combustivel > 40 else AMBAR if m.combustivel > 20 else VERMELHO)
        cv.itemconfig(h["pontos"], text=_("PONTOS  {p}").format(p=f"{estado['pontos']:06d}"), fill=LARANJA)
        cv.itemconfig(h["local"], text=_("Local {n}: {nome}").format(n=m.nivel + 1, nome=m.local["nome"]))
        v = m.vento()
        seta = "→" if v > 0.05 else "←" if v < -0.05 else "·"
        cv.itemconfig(h["vento"], text=_("Vento {s} {v} m/s²").format(s=seta, v=num(abs(v), 1)) if m.vento_max
                      else _("Sem vento"))
        cv.itemconfig(h["vidas"], text=_("Sondas  ") + "▲ " * estado["vidas"])
        cv.itemconfig(h["recorde"], text=_("Recorde {p}").format(p=f"{max(estado['recorde'], estado['pontos']):06d}"))

    # ---------------------------------------------------------- telas
    def novo_nivel():
        cv.delete("all")
        m = Mundo(estado["nivel"])
        estado["mundo"] = m
        estado["particulas"].clear()
        estado["poeira"] = []
        estado["alerta"] = 100
        rnd = random.Random(estado["nivel"] * 7 + 1)
        desenhar_ceu(m.local, rnd)
        desenhar_terreno(m)
        if m.vento_max:
            for _i in range(26):
                estado["poeira"].append([rnd.uniform(0, LARGURA), rnd.uniform(60, ALTURA - 60),
                                         cv.create_line(0, 0, 0, 0, fill=AREIA, width=1, tags="poeira")])
        estado["chama"] = cv.create_polygon(0, 0, 0, 0, 0, 0, fill=LARANJA, outline=AMBAR, tags="sonda")
        estado["sonda"] = cv.create_image(m.x, m.y, image=sprite_para(0), tags="sonda")
        estado["seta"] = cv.create_text(0, 0, text="", fill=LARANJA, font=(FONTE, -16, "bold"), tags="sonda")
        criar_hud()
        atualizar_hud(m)
        texto_pixel(LARGURA / 2, 150, m.local["nome"], 5, LARANJA, tag="aviso")
        cv.create_text(LARGURA / 2, 205, text=_("Pouse numa plataforma: devagar e reto."), fill=CREME,
                       font=(FONTE, -16), tags="aviso")
        root.after(2200, lambda: cv.delete("aviso"))
        estado["tela"] = "jogo"
        tocar("pouso-inicio")

    def tela_titulo():
        cv.delete("all")
        estado["tela"] = "titulo"
        rnd = random.Random(3)
        desenhar_ceu(dict(LOCAIS[1], terra=False), rnd)
        m = Mundo(0, semente=11)
        m.local = dict(LOCAIS[1])
        desenhar_terreno(m)
        texto_pixel(LARGURA / 2, 90, titulo_jogo, 7, LARANJA)
        cv.create_text(LARGURA / 2, 168, text=_("Pouse a sonda em Marte sem fazer uma cratera nova."),
                       fill=CREME, font=(FONTE, -18))
        ajuda = [_("←  →    girar a sonda"), _("↑ ou Espaço    motor"), _("P  pausa      M  som      Esc  sair")]
        for i, t in enumerate(ajuda):
            cv.create_text(LARGURA / 2, 215 + i * 24, text=t, fill=AREIA, font=(FONTE, -16))
        cv.create_text(LARGURA / 2, 300, text=_("Pouse com menos de {vy} m/s na vertical, {vx} m/s de lado "
                                                 "e {a}° de inclinação.").format(
            vy=num(LIMITE_VY, 0), vx=num(LIMITE_VX, 0), a=int(LIMITE_ANG)), fill="#c9a892", font=(FONTE, -14))
        if estado["recorde"]:
            cv.create_text(LARGURA / 2, 330, text=_("Recorde: {p} pontos").format(p=estado["recorde"]),
                           fill=AMBAR, font=(FONTE, -16, "bold"))
        estado["piscar"] = cv.create_text(LARGURA / 2, 375, text=_("ENTER para começar"), fill=LARANJA,
                                          font=(FONTE, -20, "bold"))
        sonda = cv.create_image(LARGURA / 2, 420, image=sprite_para(0))
        estado["titulo_sonda"] = sonda

    def mensagem(titulo, cor, linhas, rodape):
        cv.create_rectangle(LARGURA / 2 - 300, 140, LARGURA / 2 + 300, 330 + 22 * max(0, len(linhas) - 3),
                            fill=FUNDO, outline=cor, width=3, tags="msg")
        texto_pixel(LARGURA / 2, 160, titulo, 5, cor, tag="msg")
        for i, t in enumerate(linhas):
            cv.create_text(LARGURA / 2, 225 + i * 24, text=t, fill=CREME if i == 0 else AREIA,
                           font=(FONTE, -16, "bold" if i == 0 else ""), tags="msg")
        cv.create_text(LARGURA / 2, 305 + 22 * max(0, len(linhas) - 3), text=rodape, fill=LARANJA,
                       font=(FONTE, -16, "bold"), tags="msg")

    def terminou(m):
        tipo, info = m.resultado
        if tipo == "pousou":
            ganho = m.pontos()
            estado["pontos"] += ganho
            estado["tela"] = "pousou"
            tocar("pouso-sucesso")
            hm = marstime.calcular()
            s = marstime.sinal()
            linhas = [_("{local} · sol {sol} · {mtc} MTC").format(local=m.local["nome"], sol=marstime.milhar(hm.sol),
                                                                  mtc=hm.mtc_hms[:5]),
                      _("+{g} pontos (plataforma x{m}, {c}% de combustível)").format(
                          g=ganho, m=info["mult"], c=round(m.combustivel)),
                      _("A notícia chega à Terra em {d}.").format(d=s.duracao(s.segundos))]
            mensagem(_("POUSO CONFIRMADO"), VERDE, linhas, _("ENTER: próximo local"))
        else:
            estado["vidas"] -= 1
            explodir(m)
            tocar("pouso-explosao")
            motivos = {"casco": _("A sonda tombou e bateu o casco."),
                       "angulo": _("Torta demais: mais de {a}°.").format(a=int(LIMITE_ANG)),
                       "rapido": _("Rápido demais: {v} m/s na vertical.").format(v=num(m.vy, 1)),
                       "lateral": _("Andando de lado: {v} m/s.").format(v=num(abs(m.vx), 1)),
                       "terreno": _("Fora da plataforma: o terreno é irregular.")}
            if estado["vidas"] > 0:
                estado["tela"] = "bateu"
                mensagem(_("CRATERA NOVA"), VERMELHO,
                         [motivos[info], _("Sondas restantes: {n}").format(n=estado["vidas"])],
                         _("ENTER: tentar de novo"))
            else:
                estado["tela"] = "fim"
                novo = estado["pontos"] > estado["recorde"]
                if novo:
                    estado["recorde"] = estado["pontos"]
                    salvar_recorde(estado["pontos"])
                mensagem(_("FIM DE JOGO"), VERMELHO,
                         [motivos[info], _("Pontos: {p}").format(p=estado["pontos"]),
                          _("NOVO RECORDE!") if novo else _("Recorde: {p}").format(p=estado["recorde"])],
                         _("ENTER: voltar ao início"))

    def explodir(m):
        cv.itemconfig(estado["sonda"], state="hidden")
        cv.itemconfig(estado["chama"], state="hidden")
        rnd = random.Random()
        for _i in range(70):
            a = rnd.uniform(math.pi, 2 * math.pi)
            v = rnd.uniform(40, 220)
            cor = rnd.choice((CREME, AMBAR, LARANJA, VERMELHO, ROCHA, m.local["rocha"]))
            estado["particulas"].append({"x": m.x, "y": m.y, "vx": math.cos(a) * v, "vy": math.sin(a) * v,
                                         "vida": rnd.uniform(0.6, 1.6), "cor": cor, "tam": rnd.choice((3, 3, 6)),
                                         "id": cv.create_rectangle(0, 0, 0, 0, fill=cor, outline="")})

    # ---------------------------------------------------------- particulas
    def soltar_fogo(m):
        bx, by = m.ponto(*BOCAL)
        a = math.radians(m.angulo)
        for _i in range(2):
            ang = a + random.uniform(-0.3, 0.3)
            v = random.uniform(90, 160)
            cor = random.choice((CREME, AMBAR, LARANJA, LARANJA, VERMELHO))
            estado["particulas"].append({"x": bx, "y": by, "vx": -math.sin(ang) * v + m.vx * PX_POR_M,
                                         "vy": math.cos(ang) * v + m.vy * PX_POR_M, "vida": random.uniform(0.25, 0.5),
                                         "cor": cor, "tam": 3,
                                         "id": cv.create_rectangle(0, 0, 0, 0, fill=cor, outline="")})
        if m.altitude() < 25:               # o jato levanta poeira do chao
            gx = m.x + random.uniform(-10, 10)
            gy = m.chao(gx)
            for lado in (-1, 1):
                estado["particulas"].append({"x": gx, "y": gy - 2, "vx": lado * random.uniform(60, 140),
                                             "vy": -random.uniform(10, 50), "vida": random.uniform(0.3, 0.8),
                                             "cor": m.local["borda"], "tam": 3,
                                             "id": cv.create_rectangle(0, 0, 0, 0, fill=m.local["borda"],
                                                                       outline="")})

    def mover_particulas(dt):
        vivas = []
        for p in estado["particulas"]:
            p["vida"] -= dt
            if p["vida"] <= 0:
                cv.delete(p["id"])
                continue
            p["vy"] += GRAVIDADE * PX_POR_M * dt * 4
            p["x"] += p["vx"] * dt
            p["y"] += p["vy"] * dt
            t = p["tam"]
            cv.coords(p["id"], p["x"], p["y"], p["x"] + t, p["y"] + t)
            vivas.append(p)
        estado["particulas"] = vivas[-160:]
        for p in vivas[:-160]:
            cv.delete(p["id"])

    # ---------------------------------------------------------- laco principal
    def quadro():
        agora = time.monotonic()
        dt = min(0.05, agora - estado["ultimo"])
        estado["ultimo"] = agora
        tela = estado["tela"]
        if tela == "titulo":
            vis = int(agora * 2) % 2 == 0
            cv.itemconfig(estado["piscar"], state="normal" if vis else "hidden")
            cv.coords(estado["titulo_sonda"], LARGURA / 2 + 120 * math.sin(agora * 0.7), 420 + 8 * math.sin(agora * 2))
        elif estado["mundo"] and not estado["pausa"]:
            m = estado["mundo"]
            if tela == "jogo":
                if estado["demo"]:
                    esq, dir_, motor = m.piloto()
                else:
                    esq = bool(teclas & {"Left", "a", "A"})
                    dir_ = bool(teclas & {"Right", "d", "D"})
                    motor = bool(teclas & {"Up", "space", "w", "W"})
                passos = max(1, int(dt / 0.01))
                for _i in range(passos):
                    m.passo(dt / passos, esq, dir_, motor)
                cv.coords(estado["sonda"], m.x, m.y)
                cv.itemconfig(estado["sonda"], image=sprite_para(m.angulo))
                if m.motor:
                    bx, by = m.ponto(*BOCAL)
                    a = math.radians(m.angulo)
                    comp = random.uniform(14, 26)
                    px, py = -math.sin(a), math.cos(a)
                    lx, ly = math.cos(a) * 5, math.sin(a) * 5
                    cv.coords(estado["chama"], bx - lx, by - ly, bx + lx, by + ly, bx + px * comp, by + py * comp)
                    cv.itemconfig(estado["chama"], state="normal")
                    soltar_fogo(m)
                    if agora - estado["motor_som"] > 0.33:
                        estado["motor_som"] = agora
                        tocar("pouso-motor")
                    for limite in (20, 10):
                        if m.combustivel <= limite < estado["alerta"]:
                            estado["alerta"] = limite
                            tocar("pouso-alerta")
                else:
                    cv.itemconfig(estado["chama"], state="hidden")
                if m.y < -10:
                    cv.coords(estado["seta"], m.x, 130)
                    cv.itemconfig(estado["seta"], text=f"▲ {(-m.y + ALTURA) / PX_POR_M:.0f} m")
                else:
                    cv.itemconfig(estado["seta"], text="")
                atualizar_hud(m)
                if m.resultado:
                    terminou(m)
                    atualizar_hud(m)
            mover_particulas(dt)
            # vento: poeira passando
            v = m.vento()
            for p in estado["poeira"]:
                p[0] = (p[0] + v * 40 * dt + (8 if v >= 0 else -8) * dt) % LARGURA
                comp = 4 + abs(v) * 10
                cv.coords(p[2], p[0], p[1], p[0] - comp * (1 if v >= 0 else -1), p[1])
            # Fobos e luzes das plataformas
            estado["fobos_x"] = (estado["fobos_x"] + 6 * dt) % (LARGURA + 60)
            fx = estado["fobos_x"] - 30
            cv.coords(estado["fobos"], fx, 40, fx + 14, 50)
            liga = int(agora * 2) % 2 == 0
            for luz in estado.get("luzes", []):
                cv.itemconfig(luz, fill=VERMELHO if liga else "#51323e")
            if estado["demo"] and tela in ("pousou", "bateu", "fim") and agora - estado.get("fim_demo", agora) > 2.5:
                enter()
            if tela in ("pousou", "bateu", "fim"):
                estado.setdefault("fim_demo", agora)
        cv.tag_raise("hud")
        cv.tag_raise("msg")
        cv.tag_raise("aviso")
        root.after(16, quadro)

    # ---------------------------------------------------------- teclado
    def apertou(e):
        k = e.keysym
        if k in soltar:
            root.after_cancel(soltar.pop(k))
        teclas.add(k)
        if k in ("Return", "KP_Enter"):
            enter()
        elif k in ("p", "P") and estado["tela"] == "jogo":
            estado["pausa"] = not estado["pausa"]
            if estado["pausa"]:
                texto_pixel(LARGURA / 2, 250, _("PAUSA"), 6, AMBAR, tag="msg")
            else:
                cv.delete("msg")
        elif k in ("m", "M"):
            estado["som"] = not estado["som"]
        elif k == "Escape":
            if estado["tela"] == "titulo":
                root.destroy()
            else:
                tela_titulo()

    def largou(e):
        k = e.keysym
        # o X repete teclas com pares solta/aperta: so solta mesmo se nao voltar logo
        soltar[k] = root.after(40, lambda: (teclas.discard(k), soltar.pop(k, None)))

    def enter():
        estado.pop("fim_demo", None)
        tela = estado["tela"]
        if tela == "titulo":
            estado.update(nivel=0, pontos=0, vidas=3)
            novo_nivel()
        elif tela == "pousou":
            estado["nivel"] += 1
            novo_nivel()
        elif tela == "bateu":
            novo_nivel()
        elif tela == "fim":
            tela_titulo()

    root.bind("<KeyPress>", apertou)
    root.bind("<KeyRelease>", largou)
    tela_titulo()
    if demo:
        root.after(800, enter)
    root.after(16, quadro)
    root.mainloop()


# ------------------------------------------------------------------ teste sem janela
def teste():
    """Pilota sozinho 25 pousos e confere que a fisica e o terreno fazem sentido."""
    ok = 0
    for nivel in range(10):
        for semente in range(5):
            m = Mundo(nivel, semente=semente * 31 + nivel)
            assert len(m.plataformas) == 3
            for p in m.plataformas:
                assert p["x1"] - p["x0"] >= 60 and all(m.terreno[i] == p["y"] for i in range(p["i0"], p["i1"] + 1))
            for _i in range(6000):            # ate 60 s de voo
                m.passo(0.01, *m.piloto())
                if m.resultado:
                    break
            r = m.resultado
            ok += bool(r and r[0] == "pousou")
            print(f"nivel {nivel + 1:2} {m.local['nome']:17} semente {semente}: "
                  f"{(r[0] + ' ' + (('x' + str(r[1]['mult'])) if r[0] == 'pousou' else r[1])) if r else 'sem resultado'}"
                  f"  t={m.t:4.1f}s comb={m.combustivel:3.0f}% vy={m.vy:4.1f} vx={m.vx:+4.1f} ang={m.angulo:+3.0f}"
                  f"  pontos={m.pontos()}")
    print(f"piloto automatico pousou {ok} de 50")
    return ok


if __name__ == "__main__":
    if "--teste" in sys.argv:
        sys.exit(0 if teste() >= 25 else 1)
    jogo(demo="--demo" in sys.argv)
