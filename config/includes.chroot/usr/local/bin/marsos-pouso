#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
marsos-pouso - "Pouso Marciano" / "Mars Touchdown", o jogo do MarsOS.

Pouse a sonda numa plataforma sem bater: pouco combustivel, gravidade de Marte
(3,71 m/s²) e rajadas de vento das tempestades de poeira. Cinco locais reais,
cada um mais dificil, e depois tudo de novo com o vento mais forte.

Teclas: ← →  girar    ↑ ou Espaco  motor    P  pausa    M  som    Esc  sair
Uso: marsos-pouso [--demo]        (--demo = piloto automatico)
     marsos-pouso --teste         (testa a fisica sem abrir janela)
"""
from __future__ import annotations

import configparser
import math
import os
import random
import sys
import time

sys.path.insert(0, "/usr/lib/marsos")
try:
    from marsi18n import IDIOMA, _, num
except ImportError:  # pragma: no cover
    IDIOMA = "pt"

    def _(t):
        return t

    def num(v, c=1):
        return f"{v:.{c}f}".replace(".", ",")

# ------------------------------------------------------------------ constantes
LARGURA, ALTURA = 800, 560
PX_POR_M = 3.0
GRAVIDADE = 3.71              # m/s², Marte
MOTOR = 9.0                   # aceleracao maxima do motor (m/s²)
GIRO = 120.0                  # graus por segundo
GASTO = 7.0                   # combustivel por segundo (de 100)
LIMITE_VY, LIMITE_VX, LIMITE_ANG = 3.0, 2.0, 8.0
CELULA = 4                    # terreno em degraus de 4 px (visual pixelado)
ZOOM = 3

CORES = {"o": "#3d2836", "l": "#c9a892", "b": "#e8c9a8", "c": "#c9a892", "d": "#5a6f8c",
         "e": "#8fb0d9", "f": "#ffb45e", "g": "#d97a2b", "h": "#7a5262"}
SONDA = [                      # 13 x 12, pivo no centro
    "....ooooo....",
    "...obbbbbo...",
    "..obddeebbo..",
    "..obddddcbo..",
    "..obbbbbcbo..",
    ".ooooooooooo.",
    ".offfgfffgfo.",
    ".ooooooooooo.",
    "..l..oho..l..",
    ".l..ohhho..l.",
    "l...........l",
    "ll.........ll",
]
PES = ((0.5, 11.5), (12.5, 11.5))          # coordenadas na grade da sonda
CASCO = ((6.5, 0), (1, 5.5), (12, 5.5), (6.5, 9.5))
BOCAL = (6.5, 10.0)

# Locais: nome, ceu (topo, horizonte), rocha, borda iluminada, sombra, relevo, vento, estrelas
LOCAIS = [
    {"nome": "Jezero", "ceu": ("#2a1c24", "#d29a66"), "rocha": "#8a4a3a", "borda": "#c4543c",
     "sombra": "#51323e", "relevo": "planicie", "vento": 0.0, "estrelas": 30},
    {"nome": "Gale", "ceu": ("#07050a", "#251820"), "rocha": "#6e3a3a", "borda": "#ac2f44",
     "sombra": "#3d2836", "relevo": "montanha", "vento": 0.4, "estrelas": 120, "terra": True},
    {"nome": "Elysium", "ceu": ("#b4784e", "#e8bd8a"), "rocha": "#9a5a40", "borda": "#e8a070",
     "sombra": "#6e3a3a", "relevo": "dunas", "vento": 0.7, "estrelas": 0},
    {"nome": "Valles Marineris", "ceu": ("#1a1117", "#8e4a6a"), "rocha": "#7a3a3e", "borda": "#c77a9a",
     "sombra": "#3d2836", "relevo": "canion", "vento": 0.9, "estrelas": 60},
    {"nome": "Olympus Mons", "ceu": ("#0e0a12", "#3d2836"), "rocha": "#7a4a52", "borda": "#ff8933",
     "sombra": "#3d2836", "relevo": "vulcao", "vento": 1.1, "estrelas": 160, "terra": True},
]
PLATAFORMAS = ((104, 2), (80, 3), (60, 5))   # largura em px, multiplicador de pontos


# ------------------------------------------------------------------ mundo (sem Tk)
class Mundo:
    """Terreno, sonda e fisica. Nao depende do Tk (da para testar sem janela)."""

    def __init__(self, nivel: int, semente: int | None = None):
        self.nivel = nivel                               # 0, 1, 2... (cada 5 = uma volta)
        self.local = LOCAIS[nivel % len(LOCAIS)]
        self.volta = nivel // len(LOCAIS)                # dificuldade extra
        self.rnd = random.Random(semente)
        self.terreno, self.plataformas = self.gerar_terreno()
        dif = 1.0 + 0.25 * self.volta
        self.vento_max = self.local["vento"] * dif
        self.fase_vento = self.rnd.uniform(0, 6.28), self.rnd.uniform(0, 6.28)
        # sonda chega da orbita andando de lado
        self.x = self.rnd.uniform(140, LARGURA - 140)
        self.y = 70.0
        lado = self.rnd.choice((-1, 1))
        self.vx = lado * self.rnd.uniform(6, 12) * dif   # m/s
        self.vy = self.rnd.uniform(3, 6)                 # m/s, positivo = descendo
        self.angulo = 0.0                                # graus, positivo = horario
        self.combustivel = max(45.0, 100.0 - 8 * self.volta)
        self.t = 0.0
        self.motor = False
        self.resultado = None                            # None | ("pousou", plataforma) | ("bateu", motivo)

    # ------------------------------------------------------------ terreno
    def gerar_terreno(self):
        n = LARGURA // CELULA + 1
        r = self.rnd
        tipo = self.local["relevo"]
        base = []
        for i in range(n):
            u = i / (n - 1)
            if tipo == "planicie":
                y = 470 + 25 * math.sin(u * 6.0 + 1)
            elif tipo == "montanha":
                y = 480 - 150 * math.exp(-((u - 0.62) / 0.16) ** 2)
            elif tipo == "dunas":
                y = 460 + 30 * math.sin(u * 14) + 18 * math.sin(u * 31 + 2)
            elif tipo == "canion":
                y = 360 + 160 * math.exp(-((u - 0.45) / 0.14) ** 2)
            else:  # vulcao: encosta subindo para a direita
                y = 520 - 230 * u ** 1.4
            base.append(y)
        # irregularidade (deslocamento do ponto medio)
        ruido = [0.0] * n
        passo, amp = 64, 36.0 if tipo != "planicie" else 22.0
        while passo >= 1:
            for i in range(0, n, passo):
                if i % (passo * 2):
                    a, b = i - passo, min(n - 1, i + passo)
                    ruido[i] = (ruido[a] + ruido[b]) / 2 + r.uniform(-amp, amp)
            passo //= 2
            amp *= 0.55
        alturas = [min(ALTURA - 20, max(180, base[i] + ruido[i])) for i in range(n)]
        # plataformas (planas), sem encostar umas nas outras
        plataformas = []
        celulas_livres = list(range(4, n - 4))
        for largura, mult in PLATAFORMAS:
            w = largura // CELULA
            for _tentativa in range(200):
                i0 = r.choice(celulas_livres)
                if i0 + w + 2 >= n:
                    continue
                if all(not (i0 - 3 <= p["i1"] and p["i0"] - 3 <= i0 + w) for p in plataformas):
                    break
            y = sum(alturas[i0:i0 + w]) / w
            for i in range(i0, i0 + w + 1):
                alturas[i] = y
            plataformas.append({"i0": i0, "i1": i0 + w, "x0": i0 * CELULA, "x1": (i0 + w) * CELULA,
                                "y": round(y / CELULA) * CELULA, "mult": mult})
        terreno = [round(a / CELULA) * CELULA for a in alturas]
        for p in plataformas:
            for i in range(p["i0"], p["i1"] + 1):
                terreno[i] = p["y"]
        return terreno, plataformas

    def chao(self, x: float) -> float:
        i = int(x // CELULA)
        return self.terreno[max(0, min(len(self.terreno) - 1, i))]

    def plataforma_em(self, x0: float, x1: float):
        for p in self.plataformas:
            if p["x0"] <= x0 and x1 <= p["x1"]:
                return p
        return None

    # ------------------------------------------------------------ fisica
    def vento(self) -> float:
        if not self.vento_max:
            return 0.0
        a, b = self.fase_vento
        return self.vento_max * (0.65 * math.sin(0.35 * self.t + a) + 0.35 * math.sin(1.3 * self.t + b))

    def ponto(self, gx: float, gy: float) -> tuple[float, float]:
        """Ponto da grade da sonda -> tela (girado)."""
        dx, dy = (gx - 6.5) * ZOOM, (gy - 6.0) * ZOOM
        a = math.radians(self.angulo)
        return (self.x + dx * math.cos(a) - dy * math.sin(a), self.y + dx * math.sin(a) + dy * math.cos(a))

    def altitude(self) -> float:
        pe = max(self.ponto(*p)[1] for p in PES)
        return max(0.0, (self.chao(self.x) - pe) / PX_POR_M)

    def passo(self, dt: float, esquerda=False, direita=False, motor=False):
        if self.resultado:
            return
        self.t += dt
        if esquerda:
            self.angulo -= GIRO * dt
        if direita:
            self.angulo += GIRO * dt
        self.angulo = max(-90.0, min(90.0, self.angulo))
        self.motor = motor and self.combustivel > 0
        ax, ay = self.vento(), GRAVIDADE
        if self.motor:
            a = math.radians(self.angulo)
            ax += MOTOR * math.sin(a)
            ay -= MOTOR * math.cos(a)
            self.combustivel = max(0.0, self.combustivel - GASTO * dt)
        self.vx += ax * dt
        self.vy += ay * dt
        self.x += self.vx * dt * PX_POR_M
        self.y += self.vy * dt * PX_POR_M
        if self.x < -20:
            self.x += LARGURA + 40
        elif self.x > LARGURA + 20:
            self.x -= LARGURA + 40
        self.y = max(-300.0, self.y)
        self.colisao()

    def colisao(self):
        pes = [self.ponto(*p) for p in PES]
        casco = [self.ponto(*p) for p in CASCO]
        if any(y >= self.chao(x) for x, y in casco):
            self.resultado = ("bateu", "casco")
            return
        if not any(y >= self.chao(x) for x, y in pes):
            return
        x0, x1 = min(p[0] for p in pes), max(p[0] for p in pes)
        plat = self.plataforma_em(x0, x1)
        if abs(self.angulo) > LIMITE_ANG:
            self.resultado = ("bateu", "angulo")
        elif self.vy > LIMITE_VY:
            self.resultado = ("bateu", "rapido")
        elif abs(self.vx) > LIMITE_VX:
            self.resultado = ("bateu", "lateral")
        elif not plat:
            self.resultado = ("bateu", "terreno")
        else:
            # assenta a sonda na plataforma
            self.y += plat["y"] - max(y for _x, y in pes)
            self.resultado = ("pousou", plat)

    def pontos(self) -> int:
        if not self.resultado or self.resultado[0] != "pousou":
            return 0
        plat = self.resultado[1]
        suave = 50 if self.vy < 1.5 else 0
        return int((100 + 2 * self.combustivel + suave) * plat["mult"]) + 50 * self.volta

    # ------------------------------------------------------------ piloto automatico
    def piloto(self):
        """Controle simples para o modo demo/teste: (esquerda, direita, motor)."""
        alvo = min(self.plataformas, key=lambda p: abs((p["x0"] + p["x1"]) / 2 - self.x) / p["mult"] ** 0.3)
        cx = (alvo["x0"] + alvo["x1"]) / 2
        dx = (cx - self.x) / PX_POR_M
        alt = max(0.0, (alvo["y"] - self.y) / PX_POR_M - 5.5)
        # folga sobre o relevo entre a sonda e o alvo (ou logo abaixo dela)
        a, b = sorted((self.x - 25, cx))
        trecho = self.terreno[int(max(0, a) // CELULA):int(min(LARGURA - 1, b + 25) // CELULA) + 1]
        folga = ((min(trecho) if trecho else alvo["y"]) - self.y) / PX_POR_M - 6
        # horizontal: chegar ao alvo antes do chao; perto dele, quase parado
        t_solo = max(2.0, alt / max(1.0, self.vy))
        vx_alvo = max(-10.0, min(10.0, dx / (t_solo * 0.7)))
        if abs(dx) < 6:
            vx_alvo = max(-1.0, min(1.0, dx * 0.4))
        ax = (vx_alvo - self.vx) * 1.2 - self.vento()
        ang_alvo = math.degrees(math.asin(max(-0.6, min(0.6, ax / MOTOR))))
        if alt < 10:
            ang_alvo = max(-6.0, min(6.0, ang_alvo))
        esq, dir_ = self.angulo > ang_alvo + 1.5, self.angulo < ang_alvo - 1.5
        # vertical: curva de frenagem (desce rapido no alto, devagar perto do chao)
        vy_alvo = 1.0 + math.sqrt(2 * 3.2 * max(0.0, alt - 1))
        if folga < 25 and abs(dx) > 8:
            vy_alvo = min(vy_alvo, (folga - 5) * 0.25)
        precisa_lado = abs(vx_alvo - self.vx) > 1.5 and abs(self.angulo - ang_alvo) < 10
        motor = self.vy > vy_alvo or (precisa_lado and alt > 15)
        return esq, dir_, motor


# ------------------------------------------------------------------ recorde
ARQ_RECORDE = os.path.expanduser("~/.config/marsos/pouso.ini")


def ler_recorde() -> int:
    c = configparser.ConfigParser()
    c.read(ARQ_RECORDE, encoding="utf-8")
    return c.getint("recorde", "pontos", fallback=0)


def salvar_recorde(pontos: int):
    c = configparser.ConfigParser()
    c["recorde"] = {"pontos": str(pontos), "data": time.strftime("%Y-%m-%d")}
    try:
        os.makedirs(os.path.dirname(ARQ_RECORDE), exist_ok=True)
        with open(ARQ_RECORDE, "w", encoding="utf-8") as f:
            c.write(f)
    except OSError:
        pass


# ------------------------------------------------------------------ fonte 5x7 (titulos)
