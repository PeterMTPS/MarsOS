#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
marsos-bandeja - rede e bateria no painel do MarsOS (fica encaixada no MarsBar do FVWM).

Le o estado direto do kernel (/proc e /sys), sem custo: cabo, Wi-Fi (com a forca do
sinal) ou sem rede, e a bateria quando existe. Clique para ver detalhes e configurar.
Avisa quando a rede conecta/cai e quando a bateria fica fraca.

Para testar sem notebook: MARSOS_SYS=/pasta/falsa marsos-bandeja
"""
import glob
import os
import re
import subprocess
import sys
import tkinter as tk

sys.path.insert(0, "/usr/lib/marsos")
from marsi18n import _  # noqa: E402
from marstk import AMBAR, AREIA, CREME, FONTE, FUNDO, NOITE, ROCHA, VERMELHO, janela  # noqa: E402

SYS = os.environ.get("MARSOS_SYS", "/sys")
PROC = os.environ.get("MARSOS_PROC", "/proc")
ICONES = "/usr/share/marsos/icons"
VERDE = "#b8c46a"
INTERVALO_MS = 3000


def ler(caminho):
    try:
        with open(caminho, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def rede():
    """(tipo, sinal, interface): tipo = 'cabo' | 'wifi' | 'off'; sinal 0-100 (Wi-Fi) ou None."""
    rota = None
    for linha in ler(f"{PROC}/net/route").splitlines()[1:]:
        c = linha.split()
        if len(c) > 2 and c[1] == "00000000":       # rota padrao = saida para a internet
            rota = c[0]
            break
    if not rota:
        return "off", None, None
    if os.path.isdir(f"{SYS}/class/net/{rota}/wireless") or os.path.isdir(f"{SYS}/class/net/{rota}/phy80211"):
        sinal = None
        for linha in ler(f"{PROC}/net/wireless").splitlines()[2:]:
            nome, _sep, resto = linha.partition(":")
            if nome.strip() == rota:
                try:
                    sinal = max(0, min(100, int(float(resto.split()[1].rstrip(".")) * 100 / 70)))
                except (IndexError, ValueError):
                    pass
        return "wifi", sinal, rota
    return "cabo", None, rota


def bateria():
    """(porcentagem, estado, minutos_restantes) ou None se o computador nao tem bateria.
    estado = 'carregando' | 'descarregando' | 'cheia'."""
    agora = cheio = potencia = 0.0
    porcentagens, estados = [], []
    for d in sorted(glob.glob(f"{SYS}/class/power_supply/*")):
        if ler(f"{d}/type") != "Battery" or ler(f"{d}/scope") == "Device":   # ignora mouse sem fio
            continue
        if ler(f"{d}/present") == "0":
            continue
        estados.append(ler(f"{d}/status"))
        for pre in ("energy", "charge"):
            n, f = ler(f"{d}/{pre}_now"), ler(f"{d}/{pre}_full")
            if n.isdigit() and f.isdigit() and int(f) > 0:
                agora += int(n)
                cheio += int(f)
                p = ler(f"{d}/{'power' if pre == 'energy' else 'current'}_now")
                potencia += abs(int(p)) if p.lstrip("-").isdigit() else 0
                break
        cap = ler(f"{d}/capacity")
        if cap.isdigit():
            porcentagens.append(int(cap))
    if not estados:
        return None
    pct = round(100 * agora / cheio) if cheio else (round(sum(porcentagens) / len(porcentagens)) if porcentagens else 0)
    pct = max(0, min(100, pct))
    if "Charging" in estados:
        estado = "carregando"
    elif "Discharging" in estados:
        estado = "descarregando"
    else:
        estado = "cheia"
    minutos = None
    if potencia > 0 and cheio:
        if estado == "descarregando":
            minutos = int(60 * agora / potencia)
        elif estado == "carregando":
            minutos = int(60 * (cheio - agora) / potencia)
    return pct, estado, minutos


def duracao(minutos):
    h, m = divmod(minutos, 60)
    return f"{h} h {m:02d} min" if h else f"{m} min"


def detalhes_rede(interface):
    """'Nome da conexao · 192.168.0.10' (pergunta ao NetworkManager e ao ip)."""
    partes = []
    try:
        r = subprocess.run(["nmcli", "-t", "-g", "GENERAL.CONNECTION", "device", "show", interface],
                           capture_output=True, text=True, timeout=3)
        if r.stdout.strip():
            partes.append(r.stdout.strip().replace("\\:", ":"))
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        r = subprocess.run(["ip", "-4", "-o", "addr", "show", "dev", interface],
                           capture_output=True, text=True, timeout=3)
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", r.stdout)
        if m:
            partes.append(m.group(1))
    except (OSError, subprocess.SubprocessError):
        pass
    return " · ".join(partes) or interface


def abrir(*cmd):
    try:
        subprocess.Popen(list(cmd), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


class Bandeja:
    def __init__(self):
        self.root = janela("MarsBandeja", "MarsBandeja")
        self.c = tk.Canvas(self.root, width=80, height=34, bg=FUNDO, highlightthickness=0)
        self.c.pack(fill="both", expand=True)
        try:
            self.icone_rede = tk.PhotoImage(file=f"{ICONES}/rede.png")
        except tk.TclError:
            self.icone_rede = None
        self.estado_rede = None          # (tipo, sinal, interface)
        self.estado_bat = None
        self.avisou_bateria = 100        # ultimo limite avisado (10 e 5 %)
        self.primeira = True
        self.dica = None
        self.menu = tk.Menu(self.root, tearoff=0, bg=NOITE, fg=AREIA, activebackground=VERMELHO,
                            activeforeground=CREME, disabledforeground=AMBAR, font=(FONTE, -14), bd=2)
        self.c.bind("<Button-1>", self.abrir_menu)
        self.c.bind("<Button-3>", self.abrir_menu)
        self.c.bind("<Enter>", lambda e: self.root.after(700, self.mostrar_dica))
        self.c.bind("<Leave>", lambda e: self.esconder_dica())
        self.c.bind("<Configure>", lambda e: self.desenhar())
        self.atualizar()

    # ------------------------------------------------------------ estado
    def atualizar(self):
        r, b = rede(), bateria()
        if not self.primeira:
            self.notificar(r, b)
        self.primeira = False
        self.estado_rede, self.estado_bat = r, b
        self.desenhar()
        self.root.after(INTERVALO_MS, self.atualizar)

    def notificar(self, r, b):
        antes = self.estado_rede[0] if self.estado_rede else "off"
        if antes == "off" and r[0] != "off":
            tipo = "Wi-Fi" if r[0] == "wifi" else _("cabo")
            abrir("marsos-aviso", "--titulo", _("Rede"), "--icone", "rede", "--som", "conectado",
                  "--segundos", "4", _("Conectado à rede ({t}).").format(t=tipo))
        elif antes != "off" and r[0] == "off":
            abrir("marsos-aviso", "--titulo", _("Rede"), "--icone", "rede", "--som", "desconectado",
                  _("A conexão de rede caiu."))
        if b:
            pct, estado, _min = b
            if estado != "descarregando":
                self.avisou_bateria = 100
            else:
                for limite in (5, 10):
                    if pct <= limite < self.avisou_bateria:
                        self.avisou_bateria = limite
                        abrir("marsos-aviso", "--titulo", _("Bateria fraca"), "--icone", "desligar",
                              "--som", "bateria", "--segundos", "10",
                              _("Restam {p}%. Ligue o carregador.").format(p=pct))
                        break

    # ------------------------------------------------------------ desenho
    def desenhar(self):
        c = self.c
        c.delete("all")
        w, h = max(c.winfo_width(), 60), max(c.winfo_height(), 24)
        cy = h // 2
        tipo, sinal, _if = self.estado_rede or ("off", None, None)
        x0 = 6
        if tipo == "wifi":
            cheias = 4 if sinal is None else (1 + (sinal >= 25) + (sinal >= 50) + (sinal >= 75))
            for i in range(4):
                alt = 4 + i * 3
                cor = VERDE if i < cheias else ROCHA
                c.create_rectangle(x0 + i * 4, cy + 7 - alt, x0 + i * 4 + 2, cy + 7, fill=cor, outline="")
        elif self.icone_rede is not None:
            c.create_image(x0 + 7, cy, image=self.icone_rede)
            if tipo == "off":
                c.create_line(x0 + 1, cy - 6, x0 + 14, cy + 7, fill=VERMELHO, width=2)
                c.create_line(x0 + 1, cy + 7, x0 + 14, cy - 6, fill=VERMELHO, width=2)
        x1 = x0 + 22
        if self.estado_bat:
            pct, estado, _min = self.estado_bat
            cor = VERDE if pct > 40 else AMBAR if pct > 15 else VERMELHO
            bx, by = x1, cy - 11
            c.create_rectangle(bx, by, bx + 22, by + 10, outline=AREIA, width=1)
            c.create_rectangle(bx + 23, by + 3, bx + 24, by + 7, fill=AREIA, outline="")
            c.create_rectangle(bx + 2, by + 2, bx + 2 + round(18 * pct / 100), by + 8, fill=cor, outline="")
            if estado == "carregando":
                c.create_polygon(bx + 12, by - 1, bx + 7, by + 6, bx + 11, by + 6, bx + 9, by + 12,
                                 bx + 15, by + 4, bx + 11, by + 4, fill=AMBAR, outline=FUNDO)
            c.create_text(bx + 12, cy + 7, text=f"{pct}%", fill=CREME, font=(FONTE, -12, "bold"))
        else:
            rotulo = {"wifi": "Wi-Fi", "cabo": _("LAN"), "off": "off"}[tipo]
            c.create_text(x1, cy, text=rotulo, anchor="w", fill=AREIA if tipo != "off" else VERMELHO,
                          font=(FONTE, -12, "bold"))

    # ------------------------------------------------------------ textos
    def texto_rede(self, completo=False):
        tipo, sinal, interface = self.estado_rede or ("off", None, None)
        if tipo == "off":
            return _("Rede: desconectada")
        nome = "Wi-Fi" + (f" {sinal}%" if sinal is not None else "") if tipo == "wifi" else _("cabo")
        txt = _("Rede: {t}").format(t=nome)
        return txt + (f" — {detalhes_rede(interface)}" if completo else "")

    def texto_bateria(self):
        if not self.estado_bat:
            return None
        pct, estado, minutos = self.estado_bat
        partes = [_("Bateria: {p}%").format(p=pct), _(estado)]
        if minutos:
            partes.append((_("{t} para encher") if estado == "carregando" else _("{t} restantes")).format(
                t=duracao(minutos)))
        return " · ".join(partes)

    def mostrar_dica(self):
        x, y = self.root.winfo_pointerxy()
        dentro = self.root.winfo_containing(x, y)
        if dentro is None or dentro.winfo_toplevel() != self.root or self.dica:
            return
        linhas = [self.texto_rede()] + ([self.texto_bateria()] if self.estado_bat else [])
        self.dica = tk.Toplevel(self.root, bg=VERMELHO)
        self.dica.overrideredirect(True)
        tk.Label(self.dica, text="\n".join(linhas), bg=FUNDO, fg=AREIA, font=(FONTE, -14),
                 justify="left", padx=8, pady=4).pack(padx=1, pady=1)
        self.dica.update_idletasks()
        dw, dh = self.dica.winfo_reqwidth(), self.dica.winfo_reqheight()
        sx = min(self.root.winfo_rootx(), self.root.winfo_screenwidth() - dw - 4)
        self.dica.geometry(f"+{sx}+{self.root.winfo_rooty() - dh - 6}")

    def esconder_dica(self):
        if self.dica:
            self.dica.destroy()
            self.dica = None

    def abrir_menu(self, evento):
        self.esconder_dica()
        m = self.menu
        m.delete(0, "end")
        m.add_command(label=self.texto_rede(completo=True), state="disabled")
        if self.estado_bat:
            m.add_command(label=self.texto_bateria(), state="disabled")
        m.add_separator()
        m.add_command(label=_("Configurar rede e Wi-Fi (nmtui)"),
                      command=lambda: abrir("xterm", "-title", _("Rede"), "-geometry", "90x28", "-e", "nmtui"))
        m.add_command(label=_("Configurações de rede"), command=lambda: abrir("marsos-config", "rede"))
        m.update_idletasks()
        altura = m.winfo_reqheight()
        m.tk_popup(evento.x_root, self.root.winfo_rooty() - altura)


if __name__ == "__main__":
    if "--estado" in sys.argv:          # para depurar: mostra o que a bandeja ve
        print("rede:", rede())
        print("bateria:", bateria())
        sys.exit(0)
    Bandeja().root.mainloop()
