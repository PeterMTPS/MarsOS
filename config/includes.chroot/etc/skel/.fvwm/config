# ~/.fvwm/config  -  MarsOS 1.1 "Olympus"
# Tema marciano retro para o FVWM (estilo Linux dos anos 90).
# Paleta do logo: #3d2836 #51323e #ac2f44 #e54438 #ff8933

#----------------------------------------------------------------------
# Basico
#----------------------------------------------------------------------
ImagePath /usr/share/marsos/icons:+
DefaultFont "-*-terminus-bold-r-normal-*-14-*-*-*-*-*-iso10646-1"
IgnoreModifiers L25
DesktopSize 1x1
DesktopName 0 Olympus
DesktopName 1 Valles
DesktopName 2 Gale
DesktopName 3 Jezero
EdgeScroll 0 0
EdgeResistance 0
EdgeThickness 0
ClickTime 250
MoveThreshold 3
OpaqueMoveSize unlimited
SnapAttraction 8 SameType Screen
EwmhBaseStruts 0 0 0 38

#----------------------------------------------------------------------
# Cores
#----------------------------------------------------------------------
Colorset 0 fg #e8c9a8, bg #3d2836, hi #6e4a58, sh #1a1117
Colorset 1 fg #c9a892, bg #51323e, hi #7a5262, sh #1a1117
Colorset 2 fg #fff1dc, bg #e54438, hi #ff8933, sh #ac2f44
Colorset 3 fg #e8c9a8, bg #2a1c24, hi #51323e, sh #0e0a12
Colorset 4 fg #fff1dc, bg #e54438, hi #ff8933, sh #ac2f44
Colorset 5 fg #fff1dc, bg #ac2f44, hi #e54438, sh #1a1117
Colorset 6 fg #ffb45e, bg #1a1117, hi #51323e, sh #0e0a12
Colorset 7 fg #fff1dc, bg #ac2f44, hi #e54438, sh #3d2836
Colorset 8 fg #fff1dc, bg #51323e, hi #7a5262, sh #1a1117
Colorset 9 fg #fff1dc, bg #e54438, hi #ff8933, sh #ac2f44
Colorset 10 fg #fff1dc, bg #ac2f44, hi #e54438, sh #3d2836
Colorset 11 fg #e8c9a8, bg #2a1c24, fgsh #0e0a12, hi #e54438, sh #e54438

#----------------------------------------------------------------------
# Janelas
#----------------------------------------------------------------------
Style * Colorset 1, HilightColorset 2, BorderColorset 1, HilightBorderColorset 9
Style * Font "-*-terminus-bold-r-normal-*-14-*-*-*-*-*-iso10646-1"
Style * BorderWidth 5, HandleWidth 5, MwmBorder, MwmButtons, DepressableBorder
Style * ClickToFocus, MinOverlapPlacement, DecorateTransient
Style * EWMHMaximizeUseWorkingArea, EWMHPlacementUseWorkingArea
Style * MiniIcon mini-marte.xpm, NoIcon, ResizeOpaque, WindowShadeSteps 16

Style MarsBar      !Title, !Borders, Sticky, WindowListSkip, CirculateSkip, StaysOnTop, NeverFocus, FixedPosition, FixedSize, !Iconifiable
Style FvwmPager    !Title, !Borders, Sticky, WindowListSkip, CirculateSkip
Style FvwmIconMan  !Title, !Borders, Sticky, WindowListSkip, CirculateSkip
# Apps Tk: o Tk muda o nome da classe (MarsPouso -> Marspouso), entao as regras usam o
# nome de instancia, que fica como no codigo com a primeira letra minuscula (marsPouso).
Style marsClockMini !Title, !Borders, Sticky, WindowListSkip, CirculateSkip
Style marsBandeja  !Title, !Borders, Sticky, WindowListSkip, CirculateSkip
Style marsAreas    !Title, !Borders, Sticky, WindowListSkip, CirculateSkip
Style marsOSAviso  !Title, !Borders, Sticky, WindowListSkip, CirculateSkip, StaysOnTop, NeverFocus
Style marsPouso    !Maximizable, PositionPlacement Center
Style marsClockTerra !Title, !Borders, Sticky, WindowListSkip, CirculateSkip
Style marsGlobo    !Maximizable
Style marsOSSobre  !Maximizable, PositionPlacement Center
Style marsOSEnergia !Maximizable, PositionPlacement Center, StaysOnTop
Style marsOSConfig PositionPlacement Center
Style marsOSVolume !Maximizable, !Iconifiable, StaysOnTop, PositionPlacement UnderMouse

TitleStyle Centered Height 20 -- Raised
ButtonStyle All -- UseTitleStyle
ButtonStyle 1 MiniIcon
ButtonStyle 2 Vector 4 28x28@3 72x72@3 72x28@4 28x72@3
ButtonStyle 4 Vector 7 25x25@3 75x25@3 75x75@3 25x75@3 25x25@3 25x32@4 75x32@3
ButtonStyle 6 Vector 4 25x68@3 75x68@3 75x74@4 25x74@3

#----------------------------------------------------------------------
# Funcoes
#----------------------------------------------------------------------
DestroyFunc MoverOuElevar
AddToFunc MoverOuElevar
+ I Raise
+ M Move
+ D Maximize 100 100

DestroyFunc RedimOuElevar
AddToFunc RedimOuElevar
+ I Raise
+ M Resize
+ D Lower

DestroyFunc CliqueTarefa
AddToFunc CliqueTarefa
+ I ThisWindow (Iconic) Iconify off
+ I ThisWindow Focus
+ I ThisWindow Raise

#----------------------------------------------------------------------
# Menus
#----------------------------------------------------------------------
MenuStyle * MenuColorset 3, ActiveColorset 4, GreyedColorset 3
MenuStyle * Hilight3DThin, HilightBack, ActiveFore, BorderWidth 2
MenuStyle * Font "-*-terminus-bold-r-normal-*-14-*-*-*-*-*-iso10646-1"
MenuStyle * TitleFont "-*-terminus-bold-r-normal-*-16-*-*-*-*-*-iso10646-1"
MenuStyle * PopupOffset -4 100, PopupDelay 150, TrianglesSolid
MenuStyle * VerticalItemSpacing 2 3, VerticalTitleSpacing 4 4, SeparatorsLong

# Menus e textos (portugues/ingles) ficam em ~/.fvwm/textos
Read textos

#----------------------------------------------------------------------
# Mouse e teclado
#----------------------------------------------------------------------
Mouse 1 R A Menu MenuMars
Mouse 2 R A WindowList
Mouse 3 R A Menu MenuMars
Mouse 1 1 A Menu MenuJanela
Mouse 1 2 A Close
Mouse 1 4 A Maximize 100 100
Mouse 1 6 A Iconify
Mouse 1 T A MoverOuElevar
Mouse 2 T A WindowShade
Mouse 3 T A Menu MenuJanela
Mouse 1 FS A RedimOuElevar
Mouse 1 W M Move
Mouse 3 W M Resize

Key Tab   A M  WindowList Root c c NoDeskSort, SelectOnRelease Alt_L
Key F4    A M  Close
Key F1    A M  Menu MenuMars Root c c
Key T     A CM Exec exec xterm
Key Left  A CM GotoDesk -1 0 3
Key Right A CM GotoDesk 1 0 3
# Ctrl+Alt+Shift+R: reinicia o FVWM (as Configuracoes usam isso ao mudar a resolucao)
Key R     A CMS Restart

# Teclas de volume do teclado
Key XF86AudioRaiseVolume A A Exec exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
Key XF86AudioLowerVolume A A Exec exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
Key XF86AudioMute        A A Exec exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Captura de tela: Print = tela inteira, Alt+Print = janela ativa, Shift+Print = escolher area
# (com Alt, muitos teclados mandam Sys_Req no lugar de Print)
Key Print   A N Exec exec marsos-captura tela
Key Print   A M Exec exec marsos-captura janela
Key Sys_Req A M Exec exec marsos-captura janela
Key Print   A S Exec exec marsos-captura area

#----------------------------------------------------------------------
# Painel "MarsBar" (rodape)
#----------------------------------------------------------------------
DestroyModuleConfig MarsBar: *
*MarsBar: Colorset 0
*MarsBar: Font "-*-terminus-bold-r-normal-*-14-*-*-*-*-*-iso10646-1"
*MarsBar: Frame 1
*MarsBar: Padding 3 2
*MarsBar: Rows 1
*MarsBar: Columns 64
# Botao MarsOS (abre o menu)
*MarsBar: (6x1, Icon mini-marte.xpm, Title (Side, Center) "MarsOS", Colorset 10, ActiveColorset 9, Action(Mouse 1) "Menu MenuMars Mouse -8p -100m")
# Atalhos: terminal, arquivos, navegador, editor
*MarsBar: (2x1, Icon terminal.xpm, Colorset 8, ActiveColorset 9, Action(Mouse 1) "Exec exec xterm")
*MarsBar: (2x1, Icon pasta.xpm, Colorset 8, ActiveColorset 9, Action(Mouse 1) "Exec exec xfe")
*MarsBar: (2x1, Icon globo.xpm, Colorset 8, ActiveColorset 9, Action(Mouse 1) "Exec exec marsos-navegador")
*MarsBar: (2x1, Icon editor.xpm, Colorset 8, ActiveColorset 9, Action(Mouse 1) "Exec exec xfw")
# Areas de trabalho (Olympus, Valles, Gale, Jezero)
*MarsBar: (10x1, Frame -1, Swallow (UseOld, NoKill, Respawn) "MarsAreas" "Exec exec marsos-areas")
# Janelas abertas
*MarsBar: (19x1, Frame 0, Swallow (UseOld, NoKill) "FvwmIconMan" "Module FvwmIconMan")
# Bandeja: rede, volume e bateria (clique, rodinha e botao do meio no volume)
*MarsBar: (9x1, Frame -1, Swallow (UseOld, NoKill, Respawn) "MarsBandeja" "Exec exec marsos-bandeja")
*MarsBar: (2x1, Icon engrenagem.xpm, Colorset 8, ActiveColorset 9, Action(Mouse 1) "Exec exec marsos-config")
# Relogios: Marte (sol e MTC) e Terra (hora e data)
*MarsBar: (6x1, Frame -1, Swallow (UseOld, NoKill, Respawn) "MarsClockMini" "Exec exec marsclock --mini")
*MarsBar: (4x1, Frame -1, Swallow (UseOld, NoKill, Respawn) "MarsClockTerra" "Exec exec marsclock --terra")

#----------------------------------------------------------------------
# Sons de eventos (abrir/fechar/minimizar janelas, trocar de area).
# Ligue/desligue em Configuracoes > Som. Os sons ficam em /usr/share/marsos/sons.
#----------------------------------------------------------------------
DestroyModuleConfig SonsEventos: *
*SonsEventos: Cmd Exec exec marsos-tocar
*SonsEventos: StartDelay 4
*SonsEventos: add_window abrir
*SonsEventos: destroy_window fechar
*SonsEventos: iconify minimizar
*SonsEventos: deiconify restaurar
*SonsEventos: new_desk area

DestroyModuleConfig FvwmIconMan: *
*FvwmIconMan: NumManagers 1
*FvwmIconMan: Resolution desk
*FvwmIconMan: UseWinList true
*FvwmIconMan: DrawIcons always
*FvwmIconMan: Format "%t"
*FvwmIconMan: Font "-*-terminus-bold-r-normal-*-14-*-*-*-*-*-iso10646-1"
*FvwmIconMan: ManagerGeometry 1x1
*FvwmIconMan: ButtonGeometry 200x36
*FvwmIconMan: MaxButtonWidth 200
*FvwmIconMan: ReliefThickness 2
*FvwmIconMan: Tips needed
*FvwmIconMan: TipsPlacement up
*FvwmIconMan: TipsColorset 11
*FvwmIconMan: TipsFont "-*-terminus-medium-r-normal-*-14-*-*-*-*-*-iso10646-1"
*FvwmIconMan: Colorset 0
*FvwmIconMan: PlainColorset 8
*FvwmIconMan: FocusColorset 4
*FvwmIconMan: SelectColorset 1
*FvwmIconMan: FocusAndSelectColorset 4
*FvwmIconMan: IconColorset 3
*FvwmIconMan: PlainButton up
*FvwmIconMan: SelectButton up
*FvwmIconMan: FocusButton down
*FvwmIconMan: FocusAndSelectButton down
*FvwmIconMan: IconButton flat
*FvwmIconMan: Sort none
*FvwmIconMan: FollowFocus true
*FvwmIconMan: Action Mouse 1 N sendcommand "Function CliqueTarefa"
*FvwmIconMan: Action Mouse 3 N sendcommand "Menu MenuJanela Mouse -8p -100m"
