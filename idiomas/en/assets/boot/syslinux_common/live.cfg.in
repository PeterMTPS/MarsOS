label live-@FLAVOUR@
	menu label ^Start MarsOS
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@

label live-@FLAVOUR@-persistence
	menu label MarsOS with ^persistence
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ persistence

label live-@FLAVOUR@-toram
	menu label MarsOS in ^RAM (no USB stick)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ toram

label live-@FLAVOUR@-failsafe
	menu label MarsOS in ^safe mode
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE_FAILSAFE@
